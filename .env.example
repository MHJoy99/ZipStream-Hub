# ==============================================================================
# ZipStreamHub Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or set environment variables in your operating system
# / container environment to customize ZipStreamHub runtime parameters.
#
# Precedence: Environment Variables > config.json > Default Values
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. Server Network Configuration
# ------------------------------------------------------------------------------

# IP address / interface to bind the HTTP streaming server to.
# - '0.0.0.0' binds to all network interfaces (accessible from LAN, Docker, Apple TV/Infuse, Kodi).
# - '127.0.0.1' binds strictly to localhost (accessible only on the local machine).
ZIPSTREAM_HOST=0.0.0.0

# Port number for the HTTP web GUI and REST streaming endpoints.
ZIPSTREAM_PORT=8787

# Enable verbose debug logging in terminal / stdout for diagnostic troubleshooting.
# Values: true | false (or 1 | 0)
ZIPSTREAM_DEBUG=false


# ------------------------------------------------------------------------------
# ⚙️ 2. Dynamic Memory & Buffer Engine Tuning (Up to 5GB Buffer)
# ------------------------------------------------------------------------------

# Sliding-Window Read-Ahead Prefetch Buffer Size in Megabytes (MB).
# Controls how much uncompressed video stream is held ahead in RAM per active stream.
#
# How it works:
#   ZipStreamHub uses a multi-threaded sliding-window buffer. As your media player
#   consumes video data, worker threads prefetch upstream chunks in the background.
#   When the buffer reaches capacity, upstream fetching automatically pauses (backpressure).
#   When seeking or closing, buffered memory is instantly freed.
#
# Recommended Presets based on available system RAM & Network Connection:
#
# 🟢 4GB RAM System (Low-memory VPS / Raspberry Pi / Budget PC):
#    ZIPSTREAM_PREFETCH_MB=64
#    - Forward buffer: 64 MB (~30-60 seconds of 1080p video)
#    - Minimal memory footprint, handles steady 1080p streams smoothly.
#
# 🟡 8GB - 16GB RAM System (Standard Modern Desktop / Laptop):
#    ZIPSTREAM_PREFETCH_MB=1024
#    - Forward buffer: 1024 MB (1 GB)
#    - Ideal for high-bitrate 4K HDR REMUX (60-80 Mbps) with instant fast-forward scrubbing.
#
# 🚀 32GB+ High-End PC / Gigabit Fiber Network (Maximum Full-Speed Buffering):
#    ZIPSTREAM_PREFETCH_MB=5120
#    - Forward buffer: 5120 MB (5 GB)
#    - Saturates Gigabit / Multi-Gigabit internet connections. Holds entire multi-gigabyte
#      movie segments in RAM for instant, lag-free chapter skipping and seeking.
ZIPSTREAM_PREFETCH_MB=32

# Client Socket Chunk Slicing Size in Kilobytes (KB).
# Fetched blocks from upstream are sliced into this size before writing to the media player socket.
# Smaller slices (e.g. 64KB - 128KB) ensure ultra-low seeking latency and rapid TCP ack.
# Values: 64 | 128 | 256 | 512 | 1024
ZIPSTREAM_SLICE_KB=128


# ------------------------------------------------------------------------------
# 🎬 3. Player Integration & UI Settings
# ------------------------------------------------------------------------------

# Default media player binary or alias used when clicking "Play" in GUI or CLI.
# Supported auto-detected options:
#   - mpv       (MPV Media Player)
#   - potplayer (Daum PotPlayer - Windows)
#   - vlc       (VLC Media Player)
#   - mpc-hc    (Media Player Classic Home Cinema)
#   - mpc-be    (Media Player Classic Black Edition)
#   - iina      (IINA - macOS)
#   - browser   (Built-in HTML5 in-browser video player)
ZIPSTREAM_DEFAULT_PLAYER=mpv

# Web GUI theme appearance mode.
# Values: dark | light
ZIPSTREAM_THEME=dark
