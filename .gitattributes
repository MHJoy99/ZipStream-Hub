# Set default behavior to automatically handle line endings (normalize to LF)
* text=auto eol=lf

# Explicit LF for code and text files
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.dockerignore text eol=lf
Dockerfile text eol=lf
LICENSE text eol=lf

# Windows-specific scripts must preserve CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.zip binary
*.tar.gz binary
*.exe binary
